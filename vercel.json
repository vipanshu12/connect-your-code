{
  "version": 2,
  "builds": [
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "static/**", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" },
    {
      "src": "server.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "**" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "server.py" }
  ],
  "env": {
    "SECURE_COOKIES": "1",
    "DATA_DIR": "/tmp/site-data"
  }
}
