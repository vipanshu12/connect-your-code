__pycache__/
*.py[cod]

# Build output. Vercel runs `python3 build.py` itself and publishes dist/, so
# it no longer travels through git. Regenerate locally with build.py.
dist/
_originals/
.vscode/
.DS_Store
.venv/

# The database holds the admin password hash, live session tokens and all
# CMS content. It belongs on the host's disk, never in the repo.
data/site.db
data/*.db-wal
data/*.db-shm

# Admin-uploaded media - user content, restored from the disk, not the repo.
data/uploads/*
!data/uploads/.gitkeep
