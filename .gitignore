__pycache__/
*.py[cod]

# dist/ is deliberately NOT ignored. It is what actually gets deployed: the
# host serves it directly, and git is how it gets there. Regenerate it with
# `python3 build.py` - never edit it by hand.
_originals/
.vscode/
.DS_Store
.venv/

# The database holds the admin password hash, live session tokens and all
# CMS content. It belongs on the host's disk, never in the repo.
data/site.db
data/*.db-wal
data/*.db-shm

# Admin-uploaded media - user content, restored from the disk, not the repo.
data/uploads/*
!data/uploads/.gitkeep
